venv/
.venv/
env/
ENV/

# Python Cache & Compiled Files
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Databases
db.sqlite3
*.sqlite3
db.sqlite3-journal

# Django Migrations (optional, keeping folder structure)
**/migrations/*.py
!**/migrations/__init__.py
**/migrations/__pycache__/

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

